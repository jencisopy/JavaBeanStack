<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.javabeanstack</groupId>
    <artifactId>jbs-bom</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JavaBeanStack-BOM</name>
    <description>Bill of Materials de JavaBeanStack: versiones centralizadas de los artefactos jbs-* y de las dependencias de terceros. Fuente única de versiones para el framework y sus consumidores (Oym-frame, Maker, TestProject).</description>
    <url>http://javabeanstack.org</url>

    <licenses>
        <license>
            <name>GNU Lesser General Public License, Version 3</name>
            <url>http://www.gnu.org/licenses/lgpl-3.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Jorge Andrés Enciso</name>
            <email>jorge.enciso.r@gmail.com</email>
            <organization>JavaBeanStack</organization>
            <organizationUrl>http://www.javabeanstack.org</organizationUrl>
        </developer>
        <developer>
            <name>Jorge David Enciso</name>
            <email>jorged.encyso@gmail.com</email>
            <organization>JavaBeanStack</organization>
            <organizationUrl>http://www.javabeanstack.org</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/jencisopy/JavaBeanStack.git</connection>
        <developerConnection>scm:git:https://github.com/jencisopy/JavaBeanStack.git</developerConnection>
        <url>https://github.com/jencisopy/JavaBeanStack/</url>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>nexus</id>
            <url>http://serverapps.oym.com.py:8081/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus</id>
            <url>http://serverapps.oym.com.py:8081/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>11.0.0</jakartaee.version>
        <hibernate.version>7.3.2.Final</hibernate.version>
        <wildfly.version>40.0.1.Final</wildfly.version>
        <log4j.version>2.25.4</log4j.version>
        <junit.jupiter.version>5.13.1</junit.jupiter.version>
        <poi.version>5.4.1</poi.version>
        <primefaces.version>15.0.17</primefaces.version>
        <jasperreports.version>7.0.7</jasperreports.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ============ Artefactos del framework JavaBeanStack ============ -->
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-commons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-business</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-poi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-jasper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-aws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.javabeanstack</groupId>
                <artifactId>jbs-outputs</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ============ Jakarta EE / servidor de aplicaciones ============ -->
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakartaee.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--
                Jakarta EE 11 dejó de incluir XML Binding (JAXB) y JSON-P como
                dependencias transitivas de jakarta.jakartaee-api (el jar quedó
                vacío, es solo un agregador de especificaciones). Se fuerzan aquí
                versión y scope "provided" (las implementa el servidor de
                aplicaciones) porque hibernate-core las trae con scope "test", lo
                que dejaba esas clases fuera del classpath de compilación principal.
            -->
            <dependency>
                <groupId>jakarta.xml.bind</groupId>
                <artifactId>jakarta.xml.bind-api</artifactId>
                <version>4.0.2</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>2.1.3</version>
                <scope>provided</scope>
            </dependency>
            <!--
                Jakarta Mail: la usa jbs-messaging para armar/enviar/recibir correo.
                Scope "provided": la API y la implementacion (Angus Mail) las trae el
                servidor de aplicaciones (WildFly 40, modulos jakarta.mail.api 2.1.3 y
                org.eclipse.angus.mail 2.0.4). Version alineada con la que provee el
                contenedor.
            -->
            <dependency>
                <groupId>jakarta.mail</groupId>
                <artifactId>jakarta.mail-api</artifactId>
                <version>2.1.3</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.wildfly</groupId>
                <artifactId>wildfly-ejb-client-bom</artifactId>
                <version>${wildfly.version}</version>
                <type>pom</type>
                <scope>test</scope>
            </dependency>

            <!-- ============ Capa web (PrimeFaces / JasperReports / POI) ============ -->
            <dependency>
                <groupId>org.primefaces</groupId>
                <artifactId>primefaces</artifactId>
                <version>${primefaces.version}</version>
                <classifier>jakarta</classifier>
            </dependency>
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports-servlets</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports-excel-poi</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports-groovy</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>
            <!-- Requerido por Maker-web (exportación a PDF de reportes Jasper) -->
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports-pdf</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>
            <!-- Apache POI: los tres artefactos deben ir alineados a la misma versión -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-scratchpad</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- ============ Logging / testing ============ -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
